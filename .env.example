# Public Google OAuth web client ID (not the client secret).
VITE_GOOGLE_CLIENT_ID=

# Backend that handles email login and the Google authorization-code exchange.
VITE_API_URL=https://api.thedesignhive.tech

# Set to "false" to temporarily skip the OTP phone-verification step at
# checkout. Flip back to "true" to require OTP verification again.
VITE_OTP_VERIFICATION_REQUIRED=true
